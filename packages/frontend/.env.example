# Browser-visible contract addresses for the selected MST Testnet/local deployment.
NEXT_PUBLIC_VOLT_TOKEN_ADDRESS=
NEXT_PUBLIC_VOLT_MARKET_ADDRESS=
NEXT_PUBLIC_VOLT_CERTIFICATE_ADDRESS=
NEXT_PUBLIC_VOLT_HOUSE_SCREENING_DEMO_ADDRESS=

# Optional deliberate cross-origin relayer override. Leave empty to use the
# same-origin /api/relayer proxy, which is the safer default.
NEXT_PUBLIC_RELAYER_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
