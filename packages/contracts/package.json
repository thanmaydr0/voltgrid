{
  "name": "contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "hardhat node",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "lint": "solhint \"contracts/**/*.sol\"",
    "preflight:testnet": "hardhat run scripts/preflight-testnet.ts --network testnet",
    "deploy:testnet": "hardhat run scripts/deploy-testnet.ts --network testnet",
    "roles:testnet": "hardhat run scripts/grant-roles-testnet.ts --network testnet",
    "seed:testnet": "hardhat run scripts/seed-testnet.ts --network testnet",
    "lockdown:testnet": "hardhat run scripts/lockdown-testnet.ts --network testnet",
    "verify:testnet": "hardhat run scripts/verify-testnet.ts --network testnet",
    "verify:source:testnet": "hardhat run scripts/verify-source-testnet.ts --network testnet",
    "smoke:testnet": "hardhat run scripts/smoke-testnet.ts --network testnet",
    "deploy:local": "hardhat run scripts/deploy-local.ts --network localhost",
    "seed:local": "hardhat run scripts/seed.ts --network localhost",
    "smoke:local": "hardhat run scripts/smoke-tx.ts --network localhost",
    "clean": "hardhat clean"
  },
  "dependencies": {
    "@openzeppelin/contracts": "~5.0.2",
    "voltgrid-sim-core": "*"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/prompt-sync": "^4.2.3",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.10",
    "prompt-sync": "^4.2.0",
    "solhint": "^5.0.3",
    "typescript": "^5.5.4"
  }
}
